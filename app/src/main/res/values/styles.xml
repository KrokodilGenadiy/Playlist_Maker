<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="MainScreenButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">@dimen/dimens_0_dp</item>
        <item name="cardBackgroundColor">@color/white</item>
        <item name="cardCornerRadius">@dimen/dimens_16_dp</item>
        <item name="android:background">@color/white</item>
        <item name="android:layout_marginStart">@dimen/dimens_15_dp</item>
        <item name="android:layout_marginEnd">@dimen/dimens_15_dp</item>
    </style>
    <style name="MainScreenButtonText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_margin">@dimen/dimens_4_dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/dimens_22_sp</item>
    </style>

    <style name="SettingsScreenOptionText">
        <item name="android:layout_width">@dimen/dimens_0_dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_marginStart">@dimen/dimens_16_dp</item>
        <item name="android:layout_marginTop">@dimen/dimens_21_dp</item>
        <item name="android:layout_marginBottom">@dimen/dimens_21_dp</item>
        <item name="android:layout_marginEnd">@dimen/dimens_8_dp</item>
        <item name="android:textColor">@color/black</item>
        <item name="fontFamily">@font/ys_display_regular</item>
        <item name="android:textSize">@dimen/dimens_16_sp</item>
    </style>

    <style name="SearchPlaceHolderText">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center</item>
        <item name="android:layout_marginTop">@dimen/dimens_16_dp</item>
        <item name="android:layout_marginStart">@dimen/dimens_16_dp</item>
        <item name="android:layout_marginEnd">@dimen/dimens_16_dp</item>
        <item name="android:textColor">@color/classic_text</item>
        <item name="fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/dimens_19_sp</item>
    </style>

    <style name="SingerInfoText">
        <item name="android:textColor">@color/circle_shape</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:layout_marginTop">15dp</item>
    </style>

    <style name="PLBottomSheetHandle">
        <item name="backgroundColor">@color/yp_gray</item>
    </style>

    <style name="PLEditTextForNewPlaylist">
        <item name="cursorColor">@color/blue</item>
        <item name="android:textSize">17sp</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:inputType">text</item>
        <item name="android:defaultFocusHighlightEnabled">false</item>
        <item name="android:lines">1</item>
        <item name="android:singleLine">true</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
    </style>

    <style name="EditTextThemeOverlay" parent="ThemeOverlay.AppCompat"> <item name="colorAccent">@color/blue</item>
        <item name="colorControlActivated">@color/blue</item>
    </style>

    <style name="PLLayoutForNewPlaylist">
        <item name="colorAccent">@color/blue</item>
        <item name="colorControlActivated">@color/blue</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="boxStrokeColor">@color/input_field</item>
        <item name="hintTextColor">@color/input_field</item>
        <item name="boxStrokeWidthFocused">1dp</item>
        <item name="android:layout_marginHorizontal">18dp</item>
        <item name="android:textColorHint">?attr/colorOnPrimary</item>
    </style>

    <style name="PLbuttonCreateNewPlaylist">
        <item name="android:layout_marginHorizontal">18dp</item>
        <item name="android:layout_marginBottom">32dp</item>
        <item name="android:background">@drawable/button_create</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/white</item>
        <item name="cornerRadius">8dp</item>
    </style>

    <style name="PLMaterialAlertDialog.App.Title.Text" parent="MaterialAlertDialog.Material3.Title.Text">
        <item name="android:textColor">?attr/colorOnPrimary</item>
    </style>

    <style name="PLWidget.App.Button" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:titleTextColor">?attr/colorOnPrimary</item>
    </style>

    <style name="PLItemMenu">
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:textColor">?attr/colorOnPrimary</item>
        <item name="android:textSize">16sp</item>
        <item name="android:foreground">?android:attr/selectableItemBackground</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:clickable">true</item>
    </style>

    <style name="PLToolbar">
        <item name="titleTextColor">?attr/colorOnPrimary</item>
        <item name="titleTextAppearance">@style/PLTitleText</item>
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_gravity">center_vertical</item>
    </style>

    <style name="PLTitleText">
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:textSize">@dimen/dimens_22_sp</item>
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:layout_gravity">center</item>
    </style>

    <style name="TrackInfoText">
        <item name="android:textColor">@color/classic_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">@font/ys_display_regular</item>
        <item name="android:layout_marginTop">15dp</item>
    </style>

    <style name="TabText">
        <item name="android:textSize">16sp</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
    </style>

    <style name="AppSearchView" parent="Widget.AppCompat.SearchView" >
        <item name="android:textSize">@dimen/dimens_16_sp</item>
        <item name="fontFamily">@font/ys_display_regular</item>
    </style>
    <style name="IconTint">
        <item name="tint">?attr/colorOnPrimary</item>
    </style>

    <style name="FragmentTitle">
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="MediaTabLayout">
        <item name="tabTextColor">@color/track_item_name_text</item>
        <item name="tabTextAppearance">@style/TabText</item>
        <item name="tabIndicatorColor">@color/black</item>
        <item name="tabIndicatorFullWidth">false</item>
    </style>

    <style name="CustomBottomSheetDialog" parent="@style/ThemeOverlay.MaterialComponents.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/CustomBottomSheet</item>
    </style>

    <style name="CustomBottomSheet" parent="Widget.MaterialComponents.BottomSheet">
        <item name="shapeAppearanceOverlay">@style/CustomShapeAppearanceBottomSheetDialog</item>
    </style>

    <style name="CustomShapeAppearanceBottomSheetDialog" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopRight">16dp</item>
        <item name="cornerSizeTopLeft">16dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
        <item name="cornerSizeBottomLeft">0dp</item>
    </style>

    <style name="roundedCornersImageView" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="ToolbarTheme" parent="@style/ThemeOverlay.AppCompat.ActionBar">
        <item name="android:textColorSecondary">@color/second_primary</item>
        <item name="colorControlNormal">@color/second_primary</item>
    </style>

    <style name="TrackNameText" parent="Widget.MaterialComponents.TextView">
        <item name="android:background">@android:color/transparent</item>
        <item name="android:textSize">@dimen/dimens_22_sp</item>
        <item name="android:textColor">@color/primary</item>
        <item name="android:fontFamily">@font/ys_display_medium</item>
        <item name="android:elevation">0dp</item>
        <item name="android:stateListAnimator">@null</item>
    </style>

    <style name="TrackArtistText" parent="TrackNameText">
        <item name="android:textSize">@dimen/dimens_14_sp</item>
    </style>
</resources>