<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_nav_graph"
    app:startDestination="@id/mediaFragment">

    <fragment
        android:id="@+id/searchFragment"
        android:name="com.zaus_app.playlistmaker.presentation.fragments.search_fragment.SearchFragment"
        android:label="fragment_search"
        tools:layout="@layout/fragment_search" >
    </fragment>

    <fragment
        android:id="@+id/mediaFragment"
        android:name="com.zaus_app.playlistmaker.presentation.fragments.MediaFragment"
        android:label="fragment_media"
        tools:layout="@layout/fragment_media" >
        <action
            android:id="@+id/action_mediaFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.zaus_app.playlistmaker.presentation.fragments.settings_fragment.SettingsFragment"
        android:label="fragment_settings"
        tools:layout="@layout/fragment_settings" />
    <fragment
        android:id="@+id/playerFragment"
        android:name="com.zaus_app.playlistmaker.presentation.fragments.player_fragment.PlayerFragment"
        android:label="fragment_player"
        tools:layout="@layout/fragment_player" >
        <action
            android:id="@+id/action_playerFragment_to_addTrackFragment"
            app:destination="@id/addTrackFragment" />
    </fragment>
    <fragment
        android:id="@+id/newPlaylistFragment"
        android:name="com.zaus_app.playlistmaker.presentation.fragments.new_playlist.NewPlaylistFragment"
        android:label="fragment_new_playlist"
        tools:layout="@layout/fragment_new_playlist" />
    <dialog
        android:id="@+id/addTrackFragment"
        android:name="com.zaus_app.playlistmaker.presentation.fragments.add_track_to_playlist.AddTrackFragment"
        android:label="fragment_add_track"
        tools:layout="@layout/fragment_add_track" >
        <action
            android:id="@+id/action_addTrackFragment_to_newPlaylistFragment"
            app:destination="@id/newPlaylistFragment" />
    </dialog>


</navigation>