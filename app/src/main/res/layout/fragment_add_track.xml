<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:behavior_hideable="true"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
    android:layout_width="match_parent"
    android:layout_height="505dp"
    android:background="@drawable/rounded_dialog"
    tools:context=".presentation.fragments.add_track_to_playlist.AddTrackFragment">


    <ImageView
        style="@style/PLBottomSheetHandle"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/pl_rectangle_bottom_sheet" />

    <TextView
        android:id="@+id/addToPlaylist"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginTop="42dp"
        android:fontFamily="@font/ys_display_medium"
        android:text="@string/addToPlaylist"
        android:textColor="?attr/colorOnPrimary"
        android:textSize="19sp" />

    <androidx.appcompat.widget.AppCompatButton
        android:id="@+id/new_playlist"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/create_playlist_text"
        android:padding="@dimen/dimens_12_dp"
        android:textSize="@dimen/dimens_14_sp"
        android:textAllCaps="false"
        android:clickable="true"
        android:fontFamily="@font/ys_display_medium"
        android:textColor="@color/primary"
        android:background="@drawable/refresh_button_background"
        app:layout_constraintTop_toBottomOf="@id/addToPlaylist"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginVertical="@dimen/dimens_24_dp"
        android:visibility="visible"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/PlaylistsRecycler"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/new_playlist"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/dimens_24_dp"
        tools:listitem="@layout/item_add_track" />

</androidx.constraintlayout.widget.ConstraintLayout>
